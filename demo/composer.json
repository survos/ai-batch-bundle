{
    "name": "survos/ai-batch-demo",
    "description": "Symfony AI 0.14 native OpenAI batch demo: submit, persist a JobHandle, and fetch per-request results.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "symfony/framework-bundle": "^8.0",
        "symfony/console": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/flex": "^2.10",
        "symfony/yaml": "^8.0",
        "symfony/ai-platform": "^0.14",
        "symfony/ai-open-ai-platform": "^0.14",
        "symfony/ai-bundle": "^0.14",
        "symfony/filesystem": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/flex": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
